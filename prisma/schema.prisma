generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT_AGENT
  ANALYST
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  SHARED_POST
  SHARED_STORY
  STICKER
}

enum ConversationKind {
  DIRECT
  GROUP
  CHANNEL
}

enum ConversationRole {
  MEMBER
  ADMIN
}

enum IdentityProvider {
  GOOGLE
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MESSAGE
  MENTION
  SHARE
}

// ─────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────
enum PushDeliveryStatus {
  QUEUED
  SENDING
  RECEIPT_PENDING
  RECEIPT_OK
  FAILED
  CANCELLED
  UNKNOWN
}

model PushDevice {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String @unique @map("device_id")
  token String? @unique
  tokenVersion Int @default(1) @map("token_version")
  deliveryMode String @default("expo-alert") @map("delivery_mode")
  platform String @default("android")
  enabled Boolean @default(true)
  invalidatedAt DateTime? @map("invalidated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deliveries PushDelivery[]
  @@index([userId, enabled])
  @@map("push_devices")
}

// Provider delivery ledger/outbox, not a second message or receipt model.
model PushDelivery {
  id String @id @default(uuid())
  messageId String @map("message_id")
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  deviceId String @map("device_id")
  device PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenVersion Int @map("token_version")
  status PushDeliveryStatus @default(QUEUED)
  ticketId String? @map("ticket_id")
  errorCode String? @map("error_code")
  attempts Int @default(0)
  receiptAttempts Int @default(0) @map("receipt_attempts")
  availableAt DateTime @default(now()) @map("available_at")
  leaseUntil DateTime? @map("lease_until")
  claimToken String? @map("claim_token")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([messageId, deviceId])
  @@index([status, availableAt, leaseUntil])
  @@index([status, updatedAt])
  @@map("push_deliveries")
}

// Durable idempotency tombstones survive message/conversation deletion.
model NotificationReplyAction {
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionId String @map("action_id")
  requestHash String @map("request_hash")
  messageId String @map("message_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@id([userId, actionId])
  @@map("notification_reply_actions")
}

model User {
  isPrivate Boolean @default(false) @map("is_private")
  commentLikes CommentLike[]
  exploreSessions ExploreSession[]
  exploreSeen ExploreSeen[]
  postInterests PostInterest[]
  notificationReplyActions NotificationReplyAction[]
  pushDevices PushDevice[]
  googleIdentities GoogleIdentity[]
  ownedConversations Conversation[] @relation("ConversationOwner")
  stickerPacks StickerPack[]
  stickerPackInstalls StickerPackInstall[]
  stickerFavorites StickerFavorite[]
  stickerRecents StickerRecent[]
  messagePushEnabled Boolean @default(true) @map("message_push_enabled")
  pushPreviewsEnabled Boolean @default(false) @map("push_previews_enabled")
  id              String        @id @default(uuid())
  username        String        @unique
  email           String        @unique
  passwordHash    String        @map("password_hash")
  displayName     String?       @map("display_name")
  bio             String?
  avatarUrl       String?       @map("avatar_url")
  isVerified      Boolean       @default(false) @map("is_verified")
  accountStatus   AccountStatus @default(ACTIVE) @map("account_status")
  suspendedAt     DateTime?     @map("suspended_at")
  suspendedReason String?       @map("suspended_reason")
  bannedAt        DateTime?     @map("banned_at")
  bannedReason    String?       @map("banned_reason")
  deletedAt       DateTime?     @map("deleted_at")
  lastActiveAt    DateTime?     @map("last_active_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Auth
  refreshTokens RefreshToken[]
  adminAccount  AdminAccount?

  // Social graph
  followers Follow[] @relation("Following")
  following Follow[] @relation("Followers")

  // Content
  posts    Post[]
  likes    Like[]
  comments Comment[]
  savedBy  SavedPost[]
  reports  Report[] @relation("Reporter")

  // Messaging
  mediaAssets MediaAsset[]
  messageDeletions MessageDeletion[]
  messageReceipts MessageReceipt[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  conversations    ConversationParticipant[]

  // Stories
  stories    Story[]
  storyViews StoryView[] @relation("StoryViews")

  // Notifications
  actorNotifications Notification[] @relation("NotificationActor")
  notifications Notification[]

  @@index([avatarUrl])
  @@index([accountStatus])
  @@index([accountStatus, isPrivate], map: "users_status_private_idx")
  @@index([createdAt])
  @@index([lastActiveAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// AUTH TOKENS
// ─────────────────────────────────────────────────────────────
model MediaAsset {
  id String @id @default(uuid())
  ownerId String @map("owner_id")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key String @unique
  url String @unique
  sourceUrl String? @map("source_url")
  mimeType String @map("mime_type")
  size Int
  createdAt DateTime @default(now()) @map("created_at")
  stickers Sticker[]
  @@index([sourceUrl])
  @@index([ownerId, createdAt])
  @@map("media_assets")
}

model GoogleIdentity {
  id String @id @default(uuid())
  provider IdentityProvider @default(GOOGLE)
  providerSubject String @map("provider_subject")
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String?
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([provider, providerSubject], map: "google_identities_provider_subject_key")
  @@unique([provider, userId], map: "google_identities_provider_user_key")
  @@index([userId])
  @@map("google_identities")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// SOCIAL GRAPH
// ─────────────────────────────────────────────────────────────
model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ─────────────────────────────────────────────────────────────
// POSTS
// ─────────────────────────────────────────────────────────────
model Post {
  interests PostInterest[]
  seen ExploreSeen[]
  mediaMetadata Json? @map("media_metadata")
  activities Notification[]
  id         String    @id @default(uuid())
  content    String
  imageUrls  String[]  @map("image_urls")
  videoUrl   String?   @map("video_url")
  authorId   String    @map("author_id")
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  shareCount Int       @default(0) @map("share_count")

  likes    Like[]
  comments Comment[]
  savedBy  SavedPost[]
  reports  Report[]

  @@index([imageUrls], type: Gin)
  @@index([videoUrl])
  @@index([authorId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("posts")
}

model Like {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, postId])
  @@index([postId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc), postId], map: "likes_user_recent_idx")
  @@map("likes")
}

model Comment {
  likes CommentLike[]
  parent Comment? @relation("CommentReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReplies")
  notifications Notification[]
  id          String    @id @default(uuid())
  content     String
  authorId    String    @map("author_id")
  postId      String    @map("post_id")
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  clientRequestId String? @map("client_request_id")
  repliedToId String?   @map("replied_to_id")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  @@unique([authorId, clientRequestId])
  @@index([postId, createdAt, id])
  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([authorId, createdAt(sort: Desc), id], map: "comments_author_recent_idx")
  @@map("comments")
}

// ─────────────────────────────────────────────────────────────
// SAVED / BOOKMARKED POSTS (Instagram-like)
// ─────────────────────────────────────────────────────────────
model SavedPost {
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, postId])
  @@index([userId, createdAt(sort: Desc), postId(sort: Desc)], map: "saved_posts_user_cursor_idx")
  @@map("saved_posts")
}

// ─────────────────────────────────────────────────────────────
// POST REPORTS
// ─────────────────────────────────────────────────────────────
model Report {
  id               String         @id @default(uuid())
  postId           String         @map("post_id")
  post             Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId       String         @map("reporter_id")
  reporter         User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason           String
  details          String?
  status           ReportStatus   @default(PENDING) @map("status")
  createdAt        DateTime       @default(now()) @map("created_at")
  reviewedAt       DateTime?      @map("reviewed_at")
  reviewedBy       String?        @map("reviewed_by")
  assignedAdminId  String?        @map("assigned_admin_id")
  assignedAdmin    AdminAccount?  @relation("AssignedReports", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  resolutionNote   String?        @map("resolution_note")
  notes            ReportNote[]

  @@index([postId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
  @@index([assignedAdminId])
  @@map("reports")
}

model ReportNote {
  id             String       @id @default(uuid())
  reportId       String       @map("report_id")
  report         Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  adminAccountId String       @map("admin_account_id")
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  note           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([reportId])
  @@index([createdAt])
  @@map("report_notes")
}

// ─────────────────────────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────────────────────────
model Conversation {
  id              String           @id @default(uuid())
  isGroup         Boolean          @default(false) @map("is_group")
  kind            ConversationKind @default(DIRECT)
  groupName       String?          @map("group_name")
  groupAvatar     String?          @map("group_avatar")
  description     String?
  ownerId         String?          @map("owner_id")
  owner           User?            @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isPublic        Boolean          @default(false) @map("is_public")
  slug            String?          @unique
  inviteTokenHash String?          @unique @map("invite_token_hash")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
  @@index([kind, isPublic, createdAt, id])
  @@index([ownerId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  role           ConversationRole @default(MEMBER)
  lastReadAt     DateTime?        @map("last_read_at")
  deletedAt      DateTime?    @map("deleted_at")

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model StickerPack {
  id          String                @id @default(uuid())
  ownerId     String?               @map("owner_id")
  owner       User?                 @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  shortName   String                @map("short_name")
  title       String
  description String?
  isPublic    Boolean               @default(false) @map("is_public")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  stickers    Sticker[]
  installs    StickerPackInstall[]
  @@unique([ownerId, shortName], map: "sticker_packs_owner_short_name_key")
  @@index([isPublic, createdAt, id], map: "sticker_packs_public_cursor_idx")
  @@index([ownerId, createdAt, id], map: "sticker_packs_owner_cursor_idx")
  @@map("sticker_packs")
}

model Sticker {
  id           String          @id @default(uuid())
  packId       String          @map("pack_id")
  pack         StickerPack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  mediaAssetId String          @unique @map("media_asset_id")
  asset        MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  emoji        String?
  position     Int
  createdAt    DateTime        @default(now()) @map("created_at")
  messages     Message[]
  favorites    StickerFavorite[]
  recents      StickerRecent[]
  @@unique([packId, position], map: "stickers_pack_position_key")
  @@index([packId, createdAt, id])
  @@map("stickers")
}

model StickerPackInstall {
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId      String      @map("pack_id")
  pack        StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  installedAt DateTime    @default(now()) @map("installed_at")
  @@id([userId, packId])
  @@index([userId, installedAt, packId])
  @@map("sticker_pack_installs")
}

model StickerFavorite {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stickerId String   @map("sticker_id")
  sticker   Sticker  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@id([userId, stickerId])
  @@index([userId, createdAt, stickerId])
  @@map("sticker_favorites")
}

model StickerRecent {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stickerId String   @map("sticker_id")
  sticker   Sticker  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  usedAt    DateTime @default(now()) @map("used_at")
  @@id([userId, stickerId])
  @@index([userId, usedAt, stickerId])
  @@map("sticker_recents")
}

model MessageReceipt {
  messageId String @map("message_id")
  userId String @map("user_id")
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime? @map("read_at")
  deliveredAt DateTime? @map("delivered_at")
  @@id([messageId, userId])
  @@index([userId, readAt])
  @@map("message_receipts")
}

model ReceiptOutbox {
  id String @id @default(uuid())
  payload Json
  availableAt DateTime @default(now()) @map("available_at")
  leaseUntil DateTime? @map("lease_until")
  claimToken String? @map("claim_token")
  attempts Int @default(0)
  @@index([availableAt, leaseUntil])
  @@map("receipt_outbox")
}

model MessageDeletion {
  messageId String @map("message_id")
  userId String @map("user_id")
  deletedAt DateTime @default(now()) @map("deleted_at")
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([messageId, userId])
  @@index([userId, deletedAt])
  @@map("message_deletions")
}

model Message {
  pushDeliveries PushDelivery[]
  deletions MessageDeletion[]
  fileName String? @map("file_name")
  fileMimeType String? @map("file_mime_type")
  fileSize Int? @map("file_size")
  pinned Boolean @default(false) @map("pinned")
  sharedReference Json? @map("shared_reference")
  stickerId       String?       @map("sticker_id")
  sticker         Sticker?      @relation(fields: [stickerId], references: [id], onDelete: SetNull)
  receipts MessageReceipt[]
  id              String        @id @default(uuid())
  content         String
  mediaUrl        String?       @map("media_url")
  thumbnailUrl    String?       @map("thumbnail_url")
  type            MessageType   @default(TEXT)
  status          MessageStatus @default(SENT) @map("status")
  senderId        String        @map("sender_id")
  receiverId      String?       @map("receiver_id")
  conversationId  String        @map("conversation_id")
  sender          User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User?         @relation("ReceivedMessages", fields: [receiverId], references: [id])
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  isRead          Boolean       @default(false) @map("is_read")
  deliveredAt     DateTime?     @map("delivered_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  editedAt        DateTime?     @map("edited_at")
  deletedAt       DateTime?     @map("deleted_at")
  deletedBy       String?       @map("deleted_by")
  duration        Float?        @map("duration")
  repliedToId     String?       @map("replied_to_id")
  repliedTo       Message?      @relation("Replies", fields: [repliedToId], references: [id])
  replies         Message[]     @relation("Replies")
  forwardedFromId String?       @map("forwarded_from_id")
  forwardedFrom   Message?      @relation("Forwards", fields: [forwardedFromId], references: [id])
  forwards        Message[]     @relation("Forwards")

  @@index([mediaUrl])
  @@index([thumbnailUrl])
  @@index([conversationId, createdAt, id])
  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([createdAt])
  @@index([type])
  @@index([repliedToId])
  @@index([forwardedFromId])
  @@index([stickerId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────
// STORIES (Instagram-style)
// ─────────────────────────────────────────────────────────────
model Story {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl   String    @map("media_url")
  mediaType  String    @map("media_type")
  caption    String?
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  deletedAt  DateTime? @map("deleted_at")
  removedBy  String?   @map("removed_by")

  views StoryView[]

  @@index([mediaUrl])
  @@index([userId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("stories")
}

model StoryView {
  storyId   String   @map("story_id")
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String   @map("viewer_id")
  viewer    User     @relation("StoryViews", fields: [viewerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([storyId, viewerId])
  @@index([viewerId])
  @@map("story_views")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────
model Notification {
  readAt DateTime? @map("read_at")
  dismissedAt DateTime? @map("dismissed_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  version Int @default(1)
  metadata Json?
  postId String? @map("post_id")
  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  dedupeKey String? @unique @map("dedupe_key")
  commentId String? @map("comment_id")
  id         String           @id @default(uuid())
  type       NotificationType
  content    String
  isRead     Boolean          @default(false) @map("is_read")
  userId     String           @map("user_id")
  actorId    String?          @map("actor_id")
  resourceId String?          @map("resource_id")
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([userId, dismissedAt, withdrawnAt, createdAt, id], map: "notifications_active_page_idx")
  @@index([userId, createdAt, id])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// ADMINISTRATION
// ─────────────────────────────────────────────────────────────
model AdminAccount {
  id              String      @id @default(uuid())
  userId          String      @unique @map("user_id")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            AdminRole   @default(MODERATOR)
  permissions     String[]    @default([])
  isActive        Boolean     @default(true) @map("is_active")
  createdByUserId String?     @map("created_by_user_id")
  disabledAt      DateTime?   @map("disabled_at")
  lastLoginAt     DateTime?   @map("last_login_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  auditLogs       AuditLog[]  @relation("AdminAuditLogs")
  assignedReports Report[]    @relation("AssignedReports")
  reportNotes     ReportNote[]
  updatedSettings PlatformSetting[] @relation("UpdatedSettings")

  @@index([role])
  @@index([isActive])
  @@map("admin_accounts")
}

model AuditLog {
  id             String       @id @default(uuid())
  adminAccountId String?      @map("admin_account_id")
  adminAccount   AdminAccount? @relation("AdminAuditLogs", fields: [adminAccountId], references: [id], onDelete: SetNull)
  action         String
  targetType     String       @map("target_type")
  targetId       String?      @map("target_id")
  reason         String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([adminAccountId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  id               String       @id @default(uuid())
  key              String       @unique
  category         String
  value            Json
  description      String?
  updatedByAdminId String?      @map("updated_by_admin_id")
  updatedByAdmin   AdminAccount? @relation("UpdatedSettings", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([category])
  @@map("platform_settings")
}


model CommentLike {
  id String @id @default(uuid())
  commentId String @map("comment_id")
  userId String @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([commentId, userId])
  @@index([userId, createdAt], map: "comment_likes_user_created_idx")
  @@map("comment_likes")
}

model ExploreSession {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  postIds String[] @map("post_ids")
  expiresAt DateTime @map("expires_at")
  @@index([userId, expiresAt], map: "explore_sessions_user_expiry_idx")
  @@index([expiresAt], map: "explore_sessions_expiry_idx")
  @@map("explore_sessions")
}

model ExploreSeen {
  sessionId String @map("session_id")
  userId String @map("user_id")
  postId String @map("post_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  seenAt DateTime @default(now()) @map("seen_at")
  @@id([userId, postId])
  @@index([userId, seenAt], map: "explore_seen_user_seen_idx")
  @@index([seenAt], map: "explore_seen_seen_idx")
  @@map("explore_seen")
}

// Recomputed from canonical interaction rows, never incremented from Kafka deltas.
model PostInterest {
  userId String @map("user_id")
  postId String @map("post_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  weight Int
  updatedAt DateTime @updatedAt @map("updated_at")
  @@id([userId, postId])
  @@index([userId, updatedAt], map: "post_interests_user_updated_idx")
  @@map("post_interests")
}
