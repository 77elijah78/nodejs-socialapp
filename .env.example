# ─── App ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_MEDIA_BASE_URL=https://api.example.com/uploads
# Legacy BASE_URL is only a fallback; never use localhost for device testing.
CORS_ORIGIN=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://social:secret@postgres:5432/social_db

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Kafka ────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=social-backend
KAFKA_GROUP_ID=social-backend-group

# ─── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Uploads ──────────────────────────────────────────────────────
UPLOADS_PATH=/app/uploads

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=info
