# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Public base URL — used to build file URLs returned to clients
BASE_URL=http://192.168.1.3:3000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/social_db?schema=public"

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Kafka ────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=social-backend
KAFKA_GROUP_ID=social-backend-group
KAFKA_PARTITIONS=3
KAFKA_REPLICATION=1

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Uploads ──────────────────────────────────────────────
# Path where files are stored on disk (absolute or relative to cwd)
UPLOADS_PATH=uploads
