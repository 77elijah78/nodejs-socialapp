# ─── App ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Set to the exact number of trusted reverse-proxy hops when running behind one.
TRUST_PROXY_HOPS=0
# Required: the public origin devices fetch /uploads from. There is no implicit
# localhost default. After changing it, run `npm run db:backfill:media-urls`.
PUBLIC_MEDIA_BASE_URL=https://api.example.com/uploads
# Legacy BASE_URL is only a fallback; never use localhost for device testing.
CORS_ORIGIN=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://social:secret@postgres:5432/social_db

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Kafka ────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=social-backend
KAFKA_GROUP_ID=social-backend-group

# ─── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional dedicated HMAC secret for privacy-preserving Redis abuse keys
ABUSE_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters

# ─── Uploads ──────────────────────────────────────────────────────
UPLOADS_PATH=/app/uploads

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Atomic Redis limits; values can be tuned independently by request category.
ABUSE_AUTH_WINDOW_MS=60000
ABUSE_AUTH_IP_MAX=40
ABUSE_AUTH_USER_MAX=15
ABUSE_AUTH_COOLDOWN_MS=60000
ABUSE_MESSAGES_WINDOW_MS=60000
ABUSE_MESSAGES_IP_MAX=300
ABUSE_MESSAGES_USER_MAX=120
ABUSE_MESSAGES_COOLDOWN_MS=30000
ABUSE_MEDIA_WINDOW_MS=60000
ABUSE_MEDIA_IP_MAX=40
ABUSE_MEDIA_USER_MAX=20
ABUSE_MEDIA_COOLDOWN_MS=120000
ABUSE_STICKERS_WINDOW_MS=60000
ABUSE_STICKERS_IP_MAX=120
ABUSE_STICKERS_USER_MAX=60
ABUSE_STICKERS_COOLDOWN_MS=30000
ABUSE_SOCIAL_WINDOW_MS=60000
ABUSE_SOCIAL_IP_MAX=180
ABUSE_SOCIAL_USER_MAX=60
ABUSE_SOCIAL_COOLDOWN_MS=30000
ABUSE_EXPLORE_WINDOW_MS=60000
ABUSE_EXPLORE_IP_MAX=60
ABUSE_EXPLORE_USER_MAX=30
ABUSE_EXPLORE_COOLDOWN_MS=60000
ABUSE_PUSH_WINDOW_MS=60000
ABUSE_PUSH_IP_MAX=60
ABUSE_PUSH_USER_MAX=30
ABUSE_PUSH_COOLDOWN_MS=60000

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Expo Android push ────────────────────────────────────────────
# Enable only after EAS project + FCM v1 credentials are configured.
PUSH_ENABLED=false
EXPO_PROJECT_ID=
# Enable Expo enhanced push security; inject the token via your secret manager.
EXPO_ACCESS_TOKEN=
